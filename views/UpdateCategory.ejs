<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Update Category</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome for icons -->
  <script src="https://kit.fontawesome.com/a2e0e6ad7e.js" crossorigin="anonymous"></script>

  <style>
  body {
    background: linear-gradient(135deg, #141e30, #243b55);
    font-family: 'Segoe UI', sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 20px;
    color: #fff;
  }

  .card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    border-radius: 20px;
    padding: 35px 40px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.5);
    width: 100%;
    max-width: 500px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .card h2 {
    text-align: center;
    color: #ffc107; /* Gold heading */
    font-weight: 700;
    margin-bottom: 30px;
  }

  .form-label {
    font-weight: 500;
    color: #fff;
  }

  .form-control {
    border-radius: 12px;
    padding: 12px 15px;
    font-size: 15px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(5px);
  }

  .form-control:focus {
    border-color: #ffc107;
    box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.3);
  }

  .btn-primary {
    background: #ffc107;
    color: #000;
    border: none;
    border-radius: 25px;
    padding: 10px 25px;
    font-size: 16px;
    transition: 0.3s;
  }

  .btn-primary:hover {
    background: #e6b800;
    box-shadow: 0 4px 12px rgba(255, 193, 7, 0.4);
  }

  .btn-secondary {
    border-radius: 25px;
    padding: 10px 25px;
    font-size: 16px;
    margin-left: 10px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: 0.3s;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .alert {
    margin-top: 20px;
    text-align: center;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #ffc107;
  }

  @media (max-width: 576px) {
    .card {
      padding: 25px 20px;
    }

    .btn {
      width: 100%;
      margin-top: 10px;
    }

    .btn-secondary {
      margin-left: 0;
    }
  }
</style>

</head>

<body>
  <div class="card">
    <h2><i class="fas fa-pen-to-square me-2"></i>Update Category</h2>

    <form action="/updatecategory" method="POST">
      <input type="hidden" name="id" value="<%= record.id %>">

      <div class="mb-3">
        <label for="name" class="form-label">Category Name</label>
        <input type="text" id="name" name="name" class="form-control" value="<%= record.name %>" required>
      </div>

      <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save me-1"></i>Update
        </button>
        <a href="/ViewCatagory" class="btn btn-secondary">
          <i class="fas fa-times-circle me-1"></i>Cancel
        </a>
      </div>

    
    </form>
  </div>
</body>
</html>
