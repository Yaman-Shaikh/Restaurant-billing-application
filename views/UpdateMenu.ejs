<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Menu Item</title>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  body {
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg, #0f0f0f, #1a1a1a);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    color: #fff;
  }

  .form-wrapper {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-radius: 20px;
    padding: 40px 35px;
    max-width: 600px;
    width: 100%;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    animation: fadeIn 0.8s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  h1 {
    text-align: center;
    color: #ffd700; /* Gold heading */
    font-weight: 700;
    margin-bottom: 30px;
  }

  label {
    font-weight: 500;
    margin-bottom: 6px;
    color: #eee;
  }

  .form-control,
  .form-select {
    border-radius: 12px;
    padding: 12px;
    font-size: 15px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: 0.3s ease;
  }
.form-control:focus,
.form-select:focus,
textarea:focus {
  border-color: #ffd700;
  box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.2);
  background: rgba(255, 255, 255, 0.12);
  color: #fff; /* Important! */
}


  input[type="file"].form-control {
    background: rgba(255, 255, 255, 0.2);
    color: #fff6f6;
    border: none;
  }

  input[type="file"].form-control::file-selector-button {
    background: #ffd700;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    margin-right: 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.3s ease;
  }

  input[type="file"].form-control::file-selector-button:hover {
    background: #e6b800;
  }

  button[type="submit"] {
    background: linear-gradient(to right, #ffd700, #9c27b0);
    border: none;
    color: #fff9f9;
    font-weight: 600;
    padding: 14px;
    font-size: 16px;
    border-radius: 12px;
    margin-top: 20px;
    width: 100%;
    transition: 0.3s ease;
  }

  button[type="submit"]:hover {
    background: linear-gradient(to right, #fdd835, #7b1fa2);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 215, 0, 0.4);
    color: #fff;
  }

  @media (max-width: 576px) {
    .form-wrapper {
      padding: 30px 20px;
    }

    h1 {
      font-size: 24px;
    }
  }
  .form-select:focus {
  background-color: #000; /* solid black background */
  color: #fff; /* white text */
}


</style>

</head>

<body>

  <div class="form-wrapper">
    <h1>Update Menu Item</h1>

    <form action="/updatemenu" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="id" value="<%= record.id %>">

      <div class="mb-3">
        <label for="name" class="form-label">Item Name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= record.item_name %>" required>
      </div>

      <div class="mb-3 kola">
        <label for="category" class="form-label">Category</label>
        <select class="form-select" id="category" name="category" required>
          <option value="">Select Category</option>
          <% categories.forEach(category => { %>
            <option value="<%= category.id %>" <%= category.id == record.category_id ? 'selected' : '' %>>
              <%= category.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description" rows="3" required><%= record.description %></textarea>
      </div>

      <div class="mb-3">
        <label for="price" class="form-label">Price (₹)</label>
        <input type="number" class="form-control" id="price" name="price" value="<%= record.price %>" required>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Update Image</label>
        <input type="file" class="form-control" id="image" name="image">
      </div>

      <button type="submit">Update Item</button>
    </form>
  </div>

</body>
</html>
