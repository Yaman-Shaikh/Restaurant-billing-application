<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>View Menu</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />

  <!-- Bootstrap & Font Awesome -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />

<style>
  body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background: #f1f4f9;
    color: #333;
    padding: 40px 20px;
  }

  .container {
    max-width: 1100px;
    margin: auto;
    background: #fff;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
    transition: 0.3s ease;
  }

  h1 {
    text-align: center;
    font-weight: 700;
    color: #222;
    margin-bottom: 30px;
    font-size: 2.2rem;
  }

  .search-bar {
    text-align: center;
    margin-bottom: 30px;
  }

  #searchInput {
    width: 100%;
    max-width: 400px;
    padding: 12px 18px;
    border-radius: 8px;
    border: 1px solid #ddd;
    font-size: 15px;
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
  }

  #searchInput:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.2);
    outline: none;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    font-size: 15px;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    overflow: hidden;
  }

  thead {
    background: #007bff;
    color: #fff;
  }

  thead th {
    padding: 15px;
    text-align: center;
    font-weight: 600;
  }

  tbody td {
    padding: 14px;
    text-align: center;
    border-bottom: 1px solid #e0e0e0;
  }

  tbody tr:nth-child(even) {
    background: #f9f9f9;
  }

  tbody tr:hover {
    background: #f1f1f1;
  }

  .action-icons a {
    margin: 0 5px;
    text-decoration: none;
  }

  .action-icons i {
    font-size: 17px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .fa-pen-to-square {
    color: #17a2b8;
  }

  .fa-trash {
    color: #dc3545;
  }

  .fa-pen-to-square:hover {
    color: #138496;
    transform: scale(1.2);
  }

  .fa-trash:hover {
    color: #c82333;
    transform: scale(1.2);
  }

  .no-data {
    text-align: center;
    padding: 20px;
    font-style: italic;
    color: #777;
  }

  .table-responsive {
    overflow-x: auto;
  }

  @media (max-width: 768px) {
    .container {
      padding: 20px;
    }
    thead th, tbody td {
      font-size: 14px;
      padding: 12px;
    }
  }
</style>


</head>

<body>

  <h1>🍽️ Menu List</h1>

  <input type="text" placeholder="Search for a dish..." onkeyup="searchMenu(this.value)" id="searchInput" />

  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>ID</th>
          <th>Item Name</th>
          <th>Price</th>
          <th>Category</th>
          <th>Description</th>
          <th>Image</th>
          <th>Update</th>
          <th>Delete</th>
        </tr>
      </thead>
      <tbody id="tbody">
        <% if (data.length > 0) { %>
          <% data.forEach((item, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= item.item_name %></td>
              <td>₹<%= item.price %></td>
              <td><%= item.category_name %></td>
              <td><%= item.description %></td>
              <td><img src="/uploads/<%= item.image %>" width="80" height="80" alt="image" /></td>
              <td><a href="/UpdateMenu?id=<%= item.id %>"><i class="fa-regular fa-pen-to-square"></i></a></td>
              <td><a href="/DeleteMenu?id=<%= item.id %>"><i class="fa-solid fa-trash"></i></a></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8">No menu items found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <script src="/searchMenu.js"></script>
</body>
</html>
