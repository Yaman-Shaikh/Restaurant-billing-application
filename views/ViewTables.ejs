<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>View Tables</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <!-- Google Fonts & Font Awesome -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>

 <style>
  * {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(135deg, #1f1c2c, #928dab);
  color: #eee;
  min-height: 100vh;
  padding: 40px 20px;
}

.container {
  max-width: 1100px;
  margin: auto;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  padding: 40px 30px;
  border-radius: 20px;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
}

h1 {
  text-align: center;
  font-size: 2.4rem;
  margin-bottom: 30px;
  font-weight: 700;
  color: #fff;
}

.search-bar {
  text-align: center;
  margin-bottom: 30px;
}

#searchInput {
  width: 100%;
  max-width: 400px;
  padding: 12px 18px;
  border-radius: 10px;
  border: none;
  background: rgba(255,255,255,0.1);
  color: #fff;
  font-size: 15px;
  outline: none;
  box-shadow: inset 0 0 5px rgba(255,255,255,0.1);
  transition: 0.3s;
}

#searchInput::placeholder {
  color: #ccc;
}

#searchInput:focus {
  background: rgba(255,255,255,0.2);
  box-shadow: 0 0 0 2px rgba(255,255,255,0.2);
}

.table-wrapper {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
  font-size: 15px;
  border-radius: 12px;
  overflow: hidden;
  background: rgba(255,255,255,0.03);
}

thead {
  background: rgba(0, 0, 0, 0.6);
}

thead th {
  padding: 16px;
  text-align: center;
  font-weight: 600;
  color: #fff;
}

tbody td {
  padding: 16px;
  text-align: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  color: #ddd;
}

tbody tr:hover {
  background: rgba(255,255,255,0.07);
}

.fa-pen-to-square {
  color: #ffc107;
  transition: all 0.2s ease;
  font-size: 17px;
}

.fa-trash {
  color: #ff4d4d;
  transition: all 0.2s ease;
  font-size: 17px;
}

.fa-pen-to-square:hover {
  transform: scale(1.2);
  color: #ffdb58;
}

.fa-trash:hover {
  transform: scale(1.2);
  color: #ff1744;
}

.no-data {
  text-align: center;
  padding: 20px;
  font-style: italic;
  color: #bbb;
}

@media (max-width: 768px) {
  h1 {
    font-size: 1.8rem;
  }

  thead th, tbody td {
    font-size: 14px;
    padding: 12px;
  }

  #searchInput {
    font-size: 14px;
  }
}

@media (max-width: 480px) {
  h1 {
    font-size: 1.5rem;
  }

  #searchInput {
    max-width: 100%;
  }

  thead th, tbody td {
    font-size: 13px;
    padding: 10px;
  }
}

 </style>
</head>
<body>

<div class="container">

    <!-- Search -->
    <div class="search-bar">
        <input type="text" id="searchInput" placeholder="Search table..." onkeyup="searchtable(this.value)">
    </div>


  <!-- Header -->
  <h1><i class="fas fa-chair me-2"></i>View Tables</h1>

  <!-- Table -->
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Capacity</th>
          <th>Availability</th>
          <th>Update</th>
          <th>Delete</th>
        </tr>
      </thead>
      <tbody id="tbody">
        <% if (data.length === 0) { %>
          <tr>
            <td colspan="5" class="no-data">No table available.</td>
          </tr>
        <% } else { %>
          <% data.forEach((item, index) => { %>
            <tr>
              <td><%= item.table_id %></td>
              <td><%= item.capacity %></td>
              <td><%= item.availability_status %></td>
              <td>
                <a href="/UpdateTable?id=<%= item.table_id %>">
                  <i class="fa-regular fa-pen-to-square"></i>
                </a>
              </td>
              <td>
                <a href="/DeleteTable?id=<%= item.table_id %>">
                  <i class="fa-solid fa-trash"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>


<script src="/searchstaff.js"></script>

 <script type='text/javascript' src="/searchtable.js"></script>


 
</body>
</html>
